# Peeqo's face: Chromium full screen on the robot's display, in the cage kiosk compositor on the first console.
# Installed by install.sh (which fills in @USER@ and @CHROMIUM@).
[Unit]
Description=Peeqo face
After=systemd-user-sessions.service plymouth-quit-wait.service peeqo.service
Wants=peeqo.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=@USER@
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=WLR_LIBINPUT_NO_DEVICES=1
# Wait for the service to answer before opening the page.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do curl -sf -o /dev/null http://localhost/face && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/cage -s -- @CHROMIUM@ --kiosk --noerrdialogs --disable-infobars --disable-session-crashed-bubble --no-first-run --password-store=basic --autoplay-policy=no-user-gesture-required --check-for-update-interval=31536000 --ozone-platform=wayland http://localhost/face
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
